            "value": "Ten link używa %@. Sprawdź temat powyżej, a następnie stuknij „Subskrybuj”, aby go dodać."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze link gebruikt %@. Controleer het onderwerp hierboven en tik op Abonneren om het toe te voegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien utilise %@. Vérifiez le sujet ci-dessus, puis touchez S’abonner pour l’ajouter."
