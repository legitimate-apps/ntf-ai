            "state": "translated",
            "value": "Sblocca il tuo dispositivo, poi tocca di nuovo il pulsante."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj urządzenie, a potem naciśnij przycisk ponownie."
          }
