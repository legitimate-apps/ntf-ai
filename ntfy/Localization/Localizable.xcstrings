    "Paste an access token created in your server's account settings. It is stored securely in the Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste an access token created in your server's account settings. It is stored securely in the Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Zugriffstoken aus den Kontoeinstellungen deines Servers ein. Es wird sicher im Schlüsselbund gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
