          }
        }
      }
    },
    "This device hasn't finished push setup for this topic yet. Until then, new messages show when you open the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device hasn't finished push setup for this topic yet. Until then, new messages show when you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat die Push-Einrichtung für dieses Thema noch nicht abgeschlossen. Bis dahin erscheinen neue Nachrichten, wenn du die App öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo aún no ha terminado de configurar las notificaciones push para este tópico. Hasta entonces, los mensajes nuevos aparecen al abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas encore terminé la configuration push de ce sujet. En attendant, les nouveaux messages s’affichent à l’ouverture de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha ancora completato la configurazione push per questo argomento. Fino ad allora i nuovi messaggi compaiono quando apri l’app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat heeft de pushinstelling voor dit onderwerp nog niet afgerond. Tot dan verschijnen nieuwe berichten als je de app opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie zakończyło jeszcze konfiguracji push dla tego tematu. Do tego czasu nowe wiadomości pojawią się po otwarciu aplikacji."
          }
        }
      }
    },
    "This message is no longer on %@, or the server doesn't keep messages.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message is no longer on %@, or the server doesn't keep messages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nachricht ist nicht mehr auf %@, oder der Server speichert keine Nachrichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mensaje ya no está en %@, o el servidor no guarda mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce message n’est plus sur %@, ou le serveur ne conserve pas les messages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo messaggio non è più su %@, oppure il server non conserva i messaggi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bericht staat niet meer op %@, of de server bewaart geen berichten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej wiadomości nie ma już na %@ albo serwer nie przechowuje wiadomości."
          }
        }
      }
    },
    "This topic on ntfy.sh can't be read without a login, so it gets no instant banners. With your login saved, its messages show when you open the app or refresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This topic on ntfy.sh can't be read without a login, so it gets no instant banners. With your login saved, its messages show when you open the app or refresh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Thema auf ntfy.sh ist ohne Login nicht lesbar und bekommt daher keine sofortigen Banner. Mit gespeichertem Login erscheinen seine Nachrichten, wenn du die App öffnest oder aktualisierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tópico de ntfy.sh no se puede leer sin iniciar sesión, así que no recibe avisos instantáneos. Con tu inicio de sesión guardado, sus mensajes aparecen al abrir la app o actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sujet sur ntfy.sh ne peut pas être lu sans identifiants de connexion : il ne reçoit donc pas de bannières instantanées. Avec vos identifiants de connexion enregistrés, ses messages s’affichent à l’ouverture de l’app ou à l’actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo argomento su ntfy.sh non si può leggere senza accesso, quindi non riceve banner immediati. Con il tuo accesso salvato, i suoi messaggi compaiono quando apri l’app o aggiorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit onderwerp op ntfy.sh is niet te lezen zonder login en krijgt daarom geen directe meldingen. Met je login opgeslagen verschijnen de berichten als je de app opent of vernieuwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego tematu na ntfy.sh nie da się czytać bez danych logowania, więc nie dostaje natychmiastowych banerów. Przy zapisanych danych logowania jego wiadomości pojawią się po otwarciu aplikacji lub odświeżeniu."
          }
        }
      }
    },
