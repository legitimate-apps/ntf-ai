    "Choose topics to subscribe to on this device. Topics already subscribed and topics on other servers are not listed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose topics to subscribe to on this device. Topics already subscribed and topics on other servers are not listed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Themen aus, die du auf diesem Gerät abonnieren möchtest. Bereits abonnierte Themen und Themen auf anderen Servern werden nicht angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los tópicos a los que suscribirte en este dispositivo. No se muestran los tópicos ya suscritos ni los de otros servidores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli gli argomenti a cui iscriverti su questo dispositivo. Gli argomenti già sottoscritti e quelli su altri server non sono elencati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tematy do subskrybowania na tym urządzeniu. Tematy już subskrybowane i tematy na innych serwerach nie są wyświetlane."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de onderwerpen waarop je je op dit apparaat wilt abonneren. Reeds geabonneerde onderwerpen en onderwerpen op andere servers worden niet getoond."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les sujets auxquels vous abonner sur cet appareil. Les sujets déjà suivis et ceux des autres serveurs ne sont pas affichés."
          }
        }
      }
    },
