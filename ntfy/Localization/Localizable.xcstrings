    },
    "See when you subscribed in Topic details. Older subscriptions show Unknown.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See when you subscribed in Topic details. Older subscriptions show Unknown."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Themendetails zeigen, wann du ein Thema abonniert hast. Bei älteren Abos steht „Unbekannt“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta cuándo te suscribiste en Detalles del tópico. Las suscripciones anteriores muestran Desconocida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Dettagli dell’argomento puoi vedere quando ti sei iscritto. Le iscrizioni precedenti mostrano Sconosciuta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W sekcji Szczegóły tematu sprawdzisz datę subskrypcji. Starsze subskrypcje mają datę Nieznana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In Onderwerpdetails zie je wanneer je je hebt geabonneerd. Bij oudere abonnementen staat Onbekend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez votre date d’abonnement dans Détails du sujet. Les anciens abonnements indiquent Inconnue."
          }
        }
      }
    },
    "Long message links work in full, words wrap normally, and Markdown code follows text size changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long message links work in full, words wrap normally, and Markdown code follows text size changes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange Links funktionieren vollständig. Text wird normal umbrochen und Markdown-Code folgt der Textgröße."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces largos funcionan completos, las palabras se ajustan con normalidad y el código Markdown sigue los cambios del tamaño de texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link lunghi funzionano per intero, le parole vanno a capo normalmente e il codice Markdown segue le modifiche alla dimensione del testo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Długie linki działają w całości, słowa zawijają się prawidłowo, a kod Markdown dostosowuje się do zmian rozmiaru tekstu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange links werken volledig, woorden lopen normaal door en Markdown-code volgt wijzigingen in de tekstgrootte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens longs fonctionnent en entier, les mots passent normalement à la ligne et le code Markdown suit les changements de taille du texte."
          }
        }
      }
    },
