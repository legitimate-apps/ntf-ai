    "The shared item could not be opened. Share it again from the original app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared item could not be opened. Share it again from the original app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geteilte Objekt konnte nicht geöffnet werden. Teile es erneut aus der ursprünglichen App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el elemento compartido. Vuelve a compartirlo desde la app original."
          }
        },
        "it": {
          "stringUnit": {
