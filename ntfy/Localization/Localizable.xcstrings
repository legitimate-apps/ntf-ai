          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propio servidor ntfy recibe avisos instantáneos con su ajuste habitual, upstream-base-url: https://ntfy.sh, y la app oficial de ntfy sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
