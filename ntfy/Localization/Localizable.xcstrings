    "Removed topics stop sending notifications, even if the first unsubscribe attempt fails.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed topics stop sending notifications, even if the first unsubscribe attempt fails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernte Themen senden keine Benachrichtigungen mehr, auch wenn das Abmelden zunächst fehlschlägt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tópicos eliminados dejan de enviar notificaciones, aunque falle el primer intento de cancelar la suscripción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli argomenti rimossi non inviano più notifiche, anche se il primo tentativo di annullare l’iscrizione non riesce."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte tematy nie wysyłają już powiadomień, nawet jeśli pierwsza próba anulowania subskrypcji się nie powiedzie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderde onderwerpen sturen geen meldingen meer, ook als het afmelden de eerste keer mislukt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sujets supprimés n’envoient plus de notifications, même si la première tentative de désabonnement échoue."
          }
        }
      }
    },
