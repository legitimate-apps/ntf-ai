          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mensaje contiene datos binarios y no se puede mostrar como texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo messaggio contiene dati binari e non può essere mostrato come testo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wiadomość zawiera dane binarne i nie można jej wyświetlić jako tekstu."
          }
        },
        "nl": {
