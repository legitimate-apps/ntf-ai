          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gedeelde onderdeel kon niet worden geopend. Deel het opnieuw vanuit de oorspronkelijke app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir l’élément partagé. Partagez-le à nouveau depuis l’app d’origine."
          }
        }
      }
    },
    "Open NTF-AI and subscribe to a topic first. Then share this item again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open NTF-AI and subscribe to a topic first. Then share this item again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne NTF-AI und abonniere zuerst ein Thema. Teile dieses Objekt danach erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre NTF-AI y suscríbete a un tópico primero. Luego vuelve a compartir este elemento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri NTF-AI e iscriviti prima a un argomento. Poi condividi di nuovo questo elemento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz NTF-AI i najpierw zasubskrybuj temat. Następnie udostępnij ten element ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open NTF-AI en abonneer je eerst op een onderwerp. Deel dit onderdeel daarna opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez NTF-AI et abonnez-vous d’abord à un sujet. Partagez ensuite cet élément à nouveau."
          }
        }
      }
    },
    "Attachments are unavailable for encrypted topics. Remove the attachment to send text or a link.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachments are unavailable for encrypted topics. Remove the attachment to send text or a link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für verschlüsselte Themen sind keine Anhänge verfügbar. Entferne den Anhang, um Text oder einen Link zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los adjuntos no están disponibles en tópicos cifrados. Quita el adjunto para enviar texto o un enlace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli allegati non sono disponibili per gli argomenti crittografati. Rimuovi l’allegato per inviare testo o un link."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załączniki są niedostępne w szyfrowanych tematach. Usuń załącznik, aby wysłać tekst lub link."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijlagen zijn niet beschikbaar voor versleutelde onderwerpen. Verwijder de bijlage om tekst of een link te verzenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièces jointes ne sont pas disponibles pour les sujets chiffrés. Supprimez la pièce jointe pour envoyer du texte ou un lien."
          }
        }
      }
    },
    "Upload limits are unavailable. Try checking again before sending the attachment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload limits are unavailable. Try checking again before sending the attachment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Upload-Limits sind nicht verfügbar. Prüfe sie erneut, bevor du den Anhang sendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los límites de carga no están disponibles. Vuelve a comprobarlos antes de enviar el adjunto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I limiti di caricamento non sono disponibili. Controlla di nuovo prima di inviare l’allegato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limity przesyłania są niedostępne. Sprawdź ponownie przed wysłaniem załącznika."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploadlimieten zijn niet beschikbaar. Controleer ze opnieuw voordat je de bijlage verzendt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les limites d’envoi sont indisponibles. Vérifiez à nouveau avant d’envoyer la pièce jointe."
          }
        }
      }
    },
