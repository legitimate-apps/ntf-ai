          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe wiadomości nie pojawią się, gdy urządzenie jest zablokowane. Stuknij „Otwórz Ustawienia” i włącz „Ekran blokady”."
          }
        },
        "nl": {
