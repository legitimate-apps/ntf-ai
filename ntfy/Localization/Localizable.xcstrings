    "Read locally stored messages, newest first. No messages are downloaded or marked as read. Choose Message to parse a JSON body in Shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read locally stored messages, newest first. No messages are downloaded or marked as read. Choose Message to parse a JSON body in Shortcuts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest lokal gespeicherte Nachrichten, neueste zuerst. Nachrichten werden weder heruntergeladen noch als gelesen markiert. Wähle Nachricht, um einen JSON-Inhalt in Kurzbefehle zu verarbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los mensajes guardados localmente, del más reciente al más antiguo. No se descargan mensajes ni se marcan como leídos. Elige Mensaje para analizar un cuerpo JSON en Atajos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge i messaggi salvati localmente, dai più recenti. I messaggi non vengono scaricati né segnati come letti. Scegli Messaggio per analizzare un corpo JSON in Comandi Rapidi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytuje lokalnie zapisane wiadomości, od najnowszych. Nie pobiera wiadomości ani nie oznacza ich jako przeczytane. Wybierz Wiadomość, aby przetworzyć treść JSON w Skrótach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest lokaal opgeslagen berichten, nieuwste eerst. Berichten worden niet gedownload of als gelezen gemarkeerd. Kies Bericht om JSON-inhoud te verwerken in Opdrachten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les messages stockés localement, du plus récent au plus ancien. Aucun message n’est téléchargé ni marqué comme lu. Choisissez Message pour analyser un corps JSON dans Raccourcis."
          }
        }
      }
    },
