    "New messages won't show while your device is locked. Tap Open Settings, then turn on Lock Screen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New messages won't show while your device is locked. Tap Open Settings, then turn on Lock Screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Nachrichten erscheinen nicht, solange dein Gerät gesperrt ist. Tippe auf „Einstellungen öffnen“ und aktiviere „Sperrbildschirm“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes nuevos no se mostrarán con el dispositivo bloqueado. Pulsa «Abrir Ajustes» y activa «Pantalla de bloqueo»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
