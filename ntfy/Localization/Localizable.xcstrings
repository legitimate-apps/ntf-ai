    "This file exceeds the server's available upload size, or is empty. Choose a smaller file or check the upload limits again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file exceeds the server's available upload size, or is empty. Choose a smaller file or check the upload limits again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei überschreitet die verfügbare Upload-Größe des Servers oder ist leer. Wähle eine kleinere Datei oder prüfe die Upload-Limits erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo supera el tamaño de carga disponible del servidor o está vacío. Elige uno más pequeño o vuelve a consultar los límites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file supera la dimensione caricabile sul server oppure è vuoto. Scegli un file più piccolo o verifica di nuovo i limiti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik przekracza dostępny rozmiar wysyłania serwera lub jest pusty. Wybierz mniejszy plik albo sprawdź limity ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand is groter dan de beschikbare uploadgrootte van de server of is leeg. Kies een kleiner bestand of controleer de limieten opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier dépasse la taille d’envoi disponible sur le serveur ou est vide. Choisissez un fichier plus petit ou vérifiez à nouveau les limites."
          }
        }
      }
    },
