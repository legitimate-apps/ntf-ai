          }
        }
      }
    },
    "New setting: Use buttons without unlocking lets you answer from the lock screen.": {
      "comment": "What's New 1.28.0",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New setting: Use buttons without unlocking lets you answer from the lock screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Einstellung: Mit „Tasten ohne Entsperren verwenden“ antwortest du direkt vom Sperrbildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo ajuste: Usar botones sin desbloquear te deja responder desde la pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveau réglage : Utiliser les boutons sans déverrouiller vous permet de répondre depuis l’écran verrouillé."
          }
        },
        "it": {
