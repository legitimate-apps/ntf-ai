    "Allow notifications in Settings to receive quiet alerts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications in Settings to receive quiet alerts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen in den Einstellungen, um Benachrichtigungen bei Stille zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
