            "state": "translated",
            "value": "Gli avvisi sono nascosti"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty są ukryte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen blijven verborgen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont masquées"
          }
        }
      }
    },
    "Banners, Lock Screen and Notification Center are all off, so new messages won't show on screen. Tap Open Settings, then turn one of them on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners, Lock Screen and Notification Center are all off, so new messages won't show on screen. Tap Open Settings, then turn one of them on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner, Sperrbildschirm und Mitteilungen sind alle deaktiviert, daher erscheinen neue Nachrichten nicht auf dem Bildschirm. Tippe auf „Einstellungen öffnen“ und aktiviere einen davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tiras, la pantalla de bloqueo y el Centro de notificaciones están desactivados, así que los mensajes nuevos no aparecerán en pantalla. Pulsa «Abrir Ajustes» y activa alguno de ellos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner, schermata di blocco e Centro Notifiche sono tutti disattivati, quindi i nuovi messaggi non compaiono sullo schermo. Tocca 'Apri Impostazioni' e attivane uno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Banery, ekran blokady i Centrum powiadomień są wyłączone, więc nowe wiadomości nie pojawią się na ekranie. Stuknij „Otwórz Ustawienia” i włącz jedno z nich."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stroken, het toegangsscherm en het meldingencentrum staan allemaal uit, dus nieuwe berichten verschijnen niet op het scherm. Tik op 'Instellingen openen' en zet er een aan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bannières, l’écran verrouillé et le centre de notifications sont tous désactivés : les nouveaux messages ne s’afficheront pas à l’écran. Touchez « Ouvrir Réglages », puis activez l’un d’eux."
          }
        }
      }
    },
    "Banners are off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners are off"
          }
        },
