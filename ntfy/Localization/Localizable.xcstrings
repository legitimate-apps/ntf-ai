    "Messages marked Not encrypted were sent without this topic's password. Anyone who knows the topic name could have sent them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages marked Not encrypted were sent without this topic's password. Anyone who knows the topic name could have sent them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten mit „Nicht verschlüsselt“ wurden ohne Passwort dieses Themas gesendet. Jeder mit Kenntnis des Themennamens könnte sie gesendet haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes marcados como «Sin cifrar» se enviaron sin la contraseña de este tópico. Cualquiera que conozca su nombre podría haberlos enviado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi contrassegnati come 'Non cifrato' sono stati inviati senza la password di questo argomento. Chiunque ne conosca il nome potrebbe averli inviati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości oznaczone jako „Niezaszyfrowane” wysłano bez hasła tego tematu. Mógł je wysłać każdy, kto zna jego nazwę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten met 'Niet versleuteld' zijn verstuurd zonder het wachtwoord van dit onderwerp. Iedereen die de onderwerpnaam kent, kan ze hebben gestuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages marqués « Non chiffré » ont été envoyés sans le mot de passe du sujet. Toute personne qui connaît le nom du sujet aurait pu les envoyer."
          }
        }
      }
    },
