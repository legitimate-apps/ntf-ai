    "Questions with a deadline show the time left, and an agent can withdraw a question it no longer needs.": {
      "comment": "What's New 1.27.0",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions with a deadline show the time left, and an agent can withdraw a question it no longer needs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen mit Frist zeigen die verbleibende Zeit, und ein Agent kann eine Frage zurückziehen, die er nicht mehr braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las preguntas con plazo muestran el tiempo restante, y un agente puede retirar una pregunta que ya no necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les questions avec une échéance affichent le temps restant, et un agent peut retirer une question dont il n’a plus besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le domande con una scadenza mostrano il tempo rimasto, e un agente può ritirare una domanda che non gli serve più."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vragen met een deadline tonen de resterende tijd, en een agent kan een vraag intrekken die hij niet meer nodig heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytania z terminem pokazują pozostały czas, a agent może wycofać pytanie, którego już nie potrzebuje."
          }
        }
      }
    },
