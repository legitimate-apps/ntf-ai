          }
        }
      }
    },
    "Alerts are hidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts are hidden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise sind verborgen"
          }
        },
        "es": {
