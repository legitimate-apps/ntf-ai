    "New topics use %@, a free public server. Any ntfy server works: turn on \"Use another server\".": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New topics use %@, a free public server. Any ntfy server works: turn on \"Use another server\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Themen nutzen %@, einen kostenlosen öffentlichen Server. Jeder ntfy-Server funktioniert: Aktiviere „Anderen Server verwenden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos tópicos usan %@, un servidor público gratuito. Puedes usar cualquier servidor ntfy: activa «Usar otro servidor»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi argomenti usano %@, un server pubblico gratuito. Funziona qualsiasi server ntfy: attiva 'Usa un altro server'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe tematy używają %@, bezpłatnego serwera publicznego. Działa dowolny serwer ntfy: włącz „Użyj innego serwera”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe onderwerpen gebruiken %@, een gratis openbare server. Elke ntfy-server werkt: zet 'Andere server gebruiken' aan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux sujets utilisent %@, un serveur public gratuit. Tout serveur ntfy convient : activez « Utiliser un autre serveur »."
          }
        }
      }
    },
