    },
    "You can turn this off anytime in Settings.": {
      "comment": "What's New 1.29.0",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn this off anytime in Settings."
          }
        },
        "de": {
