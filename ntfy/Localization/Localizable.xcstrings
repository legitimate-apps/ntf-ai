    "Agent reminders": {
      "comment": "Settings toggle: let an agent's reminder about an unanswered question alert again",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent reminders"
          }
        },
        "de": {
