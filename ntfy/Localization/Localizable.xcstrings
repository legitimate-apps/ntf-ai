    "Paste this into your agent's chat or instructions. It tells the agent how to notify you, ask you a question and read your answer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste this into your agent's chat or instructions. It tells the agent how to notify you, ask you a question and read your answer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge das in den Chat oder die Anweisungen deines Agenten ein. Dann weiß er, wie er dich benachrichtigt, dir eine Frage stellt und deine Antwort liest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega esto en el chat o las instrucciones de tu agente. Le explica cómo avisarte, hacerte una pregunta y leer tu respuesta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla questo nella chat o nelle istruzioni del tuo agente. Gli spiega come avvisarti, farti una domanda e leggere la tua risposta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej to do czatu lub instrukcji agenta. Dowie się z tego, jak cię powiadomić, zadać ci pytanie i odczytać odpowiedź."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak dit in de chat of de instructies van je agent. Zo weet die hoe hij je een melding stuurt, je een vraag stelt en je antwoord leest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez ceci dans la conversation ou les instructions de votre agent. Il saura comment vous notifier, vous poser une question et lire votre réponse."
          }
        }
      }
    },
