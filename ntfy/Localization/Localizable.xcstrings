    "Critical alerts were not allowed. You can enable them for NTF-AI in the Settings app under Notifications.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical alerts were not allowed. You can enable them for NTF-AI in the Settings app under Notifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Hinweise wurden nicht erlaubt. Du kannst sie für NTF-AI in der App „Einstellungen“ unter Mitteilungen aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se permitieron las alertas críticas. Puedes activarlas para NTF-AI en la app Ajustes, en Notificaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi critici non sono consentiti. Puoi attivarli per NTF-AI nell’app Impostazioni, sotto Notifiche."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zezwolono na alerty krytyczne. Możesz je włączyć dla NTF-AI w aplikacji Ustawienia, w sekcji Powiadomienia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritieke meldingen zijn niet toegestaan. Je kunt ze voor NTF-AI aanzetten in de app Instellingen, onder Meldingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes critiques n’ont pas été autorisées. Vous pouvez les activer pour NTF-AI dans l’app Réglages, sous Notifications."
          }
        }
      }
    },
    "Critical alerts, which play sound even when your device is silenced, need special approval from Apple and aren't offered in this app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical alerts, which play sound even when your device is silenced, need special approval from Apple and aren't offered in this app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Hinweise geben auch bei stummem Gerät einen Ton wieder. Sie erfordern eine besondere Genehmigung von Apple und sind in dieser App nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas críticas suenan incluso con el dispositivo en silencio. Requieren autorización especial de Apple y no se ofrecen en esta app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi critici, che emettono suoni anche in modalità silenziosa, richiedono un'approvazione speciale di Apple e non sono disponibili in questa app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty krytyczne odtwarzają dźwięk nawet przy wyciszonym urządzeniu. Wymagają specjalnej zgody Apple i nie są dostępne w tej aplikacji."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritieke meldingen spelen ook geluid af als je apparaat op stil staat. Hiervoor is speciale toestemming van Apple nodig; deze app biedt ze niet aan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes critiques émettent un son même en mode silencieux. Elles nécessitent une autorisation spéciale d’Apple et ne sont pas proposées dans cette app."
          }
        }
      }
    },
