    "Attachments are unavailable for encrypted topics. Your message, title, tags and click URL stay encrypted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachments are unavailable for encrypted topics. Your message, title, tags and click URL stay encrypted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge sind für verschlüsselte Themen nicht verfügbar. Nachricht, Titel, Tags und die URL beim Antippen bleiben verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los adjuntos no están disponibles para tópicos cifrados. El mensaje, título, etiquetas y URL al tocar permanecen cifrados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli allegati non sono disponibili per gli argomenti cifrati. Messaggio, titolo, etichette e URL al tocco restano cifrati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załączniki są niedostępne w zaszyfrowanych tematach. Wiadomość, tytuł, tagi i URL po stuknięciu pozostają zaszyfrowane."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijlagen zijn niet beschikbaar voor versleutelde onderwerpen. Bericht, titel, tags en tik-URL blijven versleuteld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièces jointes sont indisponibles pour les sujets chiffrés. Message, titre, étiquettes et URL au toucher restent chiffrés."
          }
        }
      }
    },
    "Attachments cannot be sent to encrypted topics. Remove the attachment and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachments cannot be sent to encrypted topics. Remove the attachment and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge können nicht an verschlüsselte Themen gesendet werden. Entferne den Anhang und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden enviar adjuntos a tópicos cifrados. Quita el adjunto y vuelve a intentarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi inviare allegati agli argomenti cifrati. Rimuovi l'allegato e riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wysyłać załączników do zaszyfrowanych tematów. Usuń załącznik i spróbuj ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt geen bijlagen naar versleutelde onderwerpen sturen. Verwijder de bijlage en probeer opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas envoyer de pièce jointe à un sujet chiffré. Retirez-la et réessayez."
          }
        }
      }
    },
    "Automatically download attachments up to the selected size. Attachments larger than this limit must be downloaded manually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically download attachments up to the selected size. Attachments larger than this limit must be downloaded manually."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge bis zur gewählten Größe automatisch herunterladen. Größere Anhänge müssen manuell heruntergeladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga automáticamente adjuntos hasta el tamaño elegido. Los más grandes se deben descargar manualmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica automaticamente gli allegati fino alla dimensione scelta. Quelli più grandi vanno scaricati manualmente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie pobieraj załączniki do wybranego rozmiaru. Większe załączniki trzeba pobrać ręcznie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download bijlagen tot de gekozen grootte automatisch. Grotere bijlagen moet je handmatig downloaden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez automatiquement les pièces jointes jusqu’à la taille choisie. Les pièces jointes plus volumineuses doivent être téléchargées manuellement."
