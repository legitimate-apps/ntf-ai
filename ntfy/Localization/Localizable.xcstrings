    "The app and its notifications now follow your phone's language when it is German.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app and its notifications now follow your phone's language when it is German."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App und ihre Benachrichtigungen erscheinen jetzt auf Deutsch, wenn dein iPhone auf Deutsch eingestellt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app y sus notificaciones ahora siguen el idioma del teléfono cuando está en alemán."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app e le sue notifiche ora seguono la lingua del telefono se è impostata sul tedesco."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja i jej powiadomienia są teraz po niemiecku, gdy telefon jest ustawiony na język niemiecki."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app en de meldingen volgen nu de taal van je telefoon als die op Duits staat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app et ses notifications s’affichent maintenant en allemand si c’est la langue de votre téléphone."
          }
        }
      }
    },
    "The app and its notifications now support Spanish, Italian, Polish, Dutch and French, following your phone's language.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app and its notifications now support Spanish, Italian, Polish, Dutch and French, following your phone's language."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App und ihre Benachrichtigungen sind jetzt auch auf Spanisch, Italienisch, Polnisch, Niederländisch und Französisch verfügbar und folgen der Sprache deines iPhones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app y sus notificaciones ahora están disponibles en español, italiano, polaco, neerlandés y francés, según el idioma de tu teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app e le sue notifiche sono ora disponibili in spagnolo, italiano, polacco, olandese e francese, in base alla lingua del tuo telefono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja i jej powiadomienia są teraz dostępne po hiszpańsku, włosku, polsku, niderlandzku i francusku, zgodnie z językiem telefonu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app en de meldingen die de app zelf maakt, zijn nu beschikbaar in het Spaans, Italiaans, Pools, Nederlands en Frans en volgen de taal van je telefoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app et ses notifications sont maintenant disponibles en espagnol, italien, polonais, néerlandais et français, selon la langue de votre téléphone."
          }
        }
      }
    },
