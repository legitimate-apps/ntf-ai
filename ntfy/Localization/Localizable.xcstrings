          }
        }
      }
    },
    "Fix silent fallback notifications when a message cannot be fetched.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix silent fallback notifications when a message cannot be fetched."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behebt stumme Ersatzbenachrichtigungen, wenn eine Nachricht nicht geladen werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se corrige la falta de sonido en las notificaciones de respaldo cuando no se puede obtener un mensaje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrette le notifiche di ripiego senza suono quando non è possibile recuperare un messaggio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprawiono brak dźwięku powiadomień zastępczych, gdy nie można pobrać wiadomości."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen stille terugvalmeldingen meer als een bericht niet kan worden opgehaald."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correction des notifications de secours silencieuses quand un message ne peut pas être récupéré."
          }
        }
      }
    },
