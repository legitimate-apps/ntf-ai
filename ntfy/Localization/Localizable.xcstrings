        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una notificación de prueba de NTF-AI. Tiene prioridad %lld. Si envías otra, puede verse diferente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una notifica di prova da NTF-AI. Ha priorità %lld. La prossima potrebbe avere un aspetto diverso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest powiadomienie testowe z NTF-AI. Ma priorytet %lld. Następne może wyglądać inaczej."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een testmelding van NTF-AI. De prioriteit is %lld. Een volgende testmelding kan er anders uitzien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est une notification de test de NTF-AI. Sa priorité est de %lld. Une autre notification peut avoir un aspect différent."
          }
        }
      }
    },
