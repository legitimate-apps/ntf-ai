    "Run HTTP notification buttons without opening the app. Unlocking is still required.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run HTTP notification buttons without opening the app. Unlocking is still required."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP-Benachrichtigungsaktionen öffnen die App nicht mehr. Entsperren bleibt nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta acciones HTTP desde las notificaciones sin abrir la app. Aún debes desbloquear el dispositivo."
          }
        },
        "it": {
