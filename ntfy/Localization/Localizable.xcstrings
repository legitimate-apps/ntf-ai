          "stringUnit": {
            "state": "translated",
            "value": "The next message from this server will be checked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Nachricht von diesem Server wird geprüft."
          }
        },
        "es": {
          "stringUnit": {
