          "stringUnit": {
            "state": "translated",
            "value": "The server refused the message (HTTP %@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Nachricht abgelehnt (HTTP %@)."
          }
        },
        "es": {
