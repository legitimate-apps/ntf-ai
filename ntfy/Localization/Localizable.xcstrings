    "Priority 4 and 5 messages are Time Sensitive. They can break through Focus and the Notification Summary when allowed in the Settings app, including your Focus settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Priority 4 and 5 messages are Time Sensitive. They can break through Focus and the Notification Summary when allowed in the Settings app, including your Focus settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten mit Priorität 4 und 5 sind zeitkritisch. Wenn du dies in der App „Einstellungen“ einschließlich der Fokus-Einstellungen erlaubst, können sie Fokus und die geplante Übersicht umgehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes de prioridad 4 y 5 son urgentes. Pueden omitir los modos de concentración y el resumen de notificaciones si lo permites en la app Ajustes, incluidos los ajustes de concentración."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi con priorità 4 e 5 sono urgenti. Possono superare Full immersion e il riepilogo notifiche se consentito nell’app Impostazioni, comprese le impostazioni di Full immersion."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości z priorytetem 4 i 5 są pilne. Gdy zezwolisz na to w aplikacji Ustawienia, w tym w ustawieniach trybu skupienia, mogą omijać tryb skupienia i podsumowanie powiadomień."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten met prioriteit 4 en 5 zijn tijdgevoelig. Ze kunnen Focus en het meldingenoverzicht doorbreken als je dit toestaat in de app Instellingen, inclusief je Focus-instellingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages de priorité 4 et 5 sont urgents. Ils peuvent franchir les modes de concentration et le résumé des notifications si vous l’autorisez dans l’app Réglages, notamment dans les réglages de concentration."
          }
        }
      }
    },
    "Priority 4 and 5 messages can now break through Focus and the Notification Summary when Time Sensitive notifications are allowed in iOS and Focus settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Priority 4 and 5 messages can now break through Focus and the Notification Summary when Time Sensitive notifications are allowed in iOS and Focus settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten mit Priorität 4 und 5 können jetzt Fokus und die geplante Übersicht umgehen, wenn zeitkritische Mitteilungen in iOS und den Fokus-Einstellungen erlaubt sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes de prioridad 4 y 5 ahora pueden omitir los modos de concentración y el resumen si permites las notificaciones urgentes en los ajustes de iOS y de concentración."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi con priorità 4 e 5 possono ora superare Full immersion e il riepilogo notifiche quando le notifiche urgenti sono consentite nelle impostazioni iOS e di Full immersion."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości z priorytetem 4 i 5 mogą teraz omijać tryb skupienia i podsumowanie powiadomień, gdy w ustawieniach iOS i trybu skupienia włączono pilne powiadomienia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten met prioriteit 4 en 5 kunnen nu Focus en het meldingenoverzicht doorbreken als tijdgevoelige meldingen zijn toegestaan in de iOS- en Focus-instellingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages de priorité 4 et 5 peuvent maintenant franchir les modes de concentration et le résumé des notifications si les notifications urgentes sont autorisées dans les réglages iOS et de concentration."
          }
        }
      }
    },
