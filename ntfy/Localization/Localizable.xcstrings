    "Use Alert if quiet to be notified when a topic receives no messages.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Alert if quiet to be notified when a topic receives no messages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bei Stille benachrichtigen“ meldet, wenn ein Thema keine Nachrichten empfängt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Avisar si no hay mensajes para recibir una alerta cuando un tópico deje de recibir mensajes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Avvisa se non arrivano messaggi per ricevere un avviso quando un argomento non riceve messaggi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Powiadom o braku wiadomości, aby otrzymać alert, gdy temat nie otrzyma wiadomości."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Melding bij stilte om een melding te krijgen als een onderwerp geen berichten ontvangt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Alerter en cas de silence pour être averti quand un sujet ne reçoit aucun message."
          }
        }
      }
    },
    "Read code blocks in monospace and choose to open web links in app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read code blocks in monospace and choose to open web links in app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies Codeblöcke in Festbreitenschrift und öffne Weblinks auf Wunsch in der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee bloques de código con letra monoespaciada y elige si abrir los enlaces web en la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
