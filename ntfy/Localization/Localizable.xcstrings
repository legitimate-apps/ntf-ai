    "Shows a receipt and the agent's note when an agent confirms your answer. Confirmations are always silent.": {
      "comment": "Settings footer under Show agent confirmations",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a receipt and the agent's note when an agent confirms your answer. Confirmations are always silent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine Bestätigung und die Notiz des Agents, wenn ein Agent deine Antwort bestätigt. Bestätigungen sind immer lautlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un recibo y la nota del agente cuando un agente confirma tu respuesta. Las confirmaciones siempre son silenciosas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra una ricevuta e la nota dell'agente quando un agente conferma la tua risposta. Le conferme sono sempre silenziose."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje potwierdzenie i notatkę agenta, gdy agent potwierdzi Twoją odpowiedź. Potwierdzenia są zawsze ciche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een ontvangstbevestiging en de notitie van de agent als een agent je antwoord bevestigt. Bevestigingen zijn altijd stil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un accusé de réception et la note de l'agent quand un agent confirme votre réponse. Les confirmations sont toujours silencieuses."
          }
        }
      }
    },
    "Inbox lists the questions agents ask you under Waiting on you, and everything else under Activity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox lists the questions agents ask you under Waiting on you, and everything else under Activity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eingang zeigt die Fragen deiner Agenten unter „Wartet auf dich“ und alles andere unter „Aktivität“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibidos muestra las preguntas de tus agentes en «Esperando tu respuesta» y todo lo demás en «Actividad»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In arrivo mostra le domande dei tuoi agenti in «In attesa di una tua risposta» e tutto il resto in «Attività»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrane pokazuje pytania od agentów w sekcji „Czeka na twoją odpowiedź”, a resztę w sekcji „Aktywność”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox toont de vragen van je agents onder ‘Wacht op jou’ en al het andere onder ‘Activiteit’."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réception affiche les questions de vos agents sous « En attente de votre réponse » et tout le reste sous « Activité »."
          }
        }
      }
    },
    "Answer an agent from the notification with a button or a typed reply. A blue tick shows the agent got it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer an agent from the notification with a button or a typed reply. A blue tick shows the agent got it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte einem Agenten direkt in der Mitteilung, per Taste oder getippter Antwort. Ein blauer Haken zeigt, dass er sie erhalten hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a un agente desde la notificación con un botón o escribiendo. Una marca azul indica que el agente la recibió."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi a un agente dalla notifica con un pulsante o scrivendo. Una spunta blu indica che l'agente l'ha ricevuta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj agentowi prosto z powiadomienia, przyciskiem lub wpisanym tekstem. Niebieski znacznik oznacza, że agent ją otrzymał."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord een agent vanuit de melding met een knop of een getypt antwoord. Een blauw vinkje laat zien dat de agent het heeft ontvangen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à un agent depuis la notification, avec un bouton ou une réponse saisie. Une coche bleue indique que l’agent l’a reçue."
          }
        }
      }
    },
    "Connect an agent shows how to link an agent or a script to a topic.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect an agent shows how to link an agent or a script to a topic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Agenten verbinden“ zeigt, wie du einen Agenten oder ein Skript mit einem Thema verbindest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Conectar un agente» explica cómo conectar un agente o un script a un tópico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Collega un agente» spiega come collegare un agente o uno script a un argomento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Połącz agenta” pokazuje, jak połączyć agenta lub skrypt z tematem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Agent koppelen’ laat zien hoe je een agent of script aan een onderwerp koppelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Connecter un agent » explique comment relier un agent ou un script à un sujet."
          }
        }
      }
    },
    "Denser message lists: long messages fold to six lines, and row actions are in the long-press menu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Denser message lists: long messages fold to six lines, and row actions are in the long-press menu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompaktere Nachrichtenlisten: Lange Nachrichten werden auf sechs Zeilen gekürzt, Aktionen findest du im Kontextmenü."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
