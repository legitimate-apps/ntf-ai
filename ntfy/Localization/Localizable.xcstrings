    "The server refused access. Check this server's account and topic write permissions in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused access. Check this server's account and topic write permissions in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat den Zugriff verweigert. Prüfe das Konto dieses Servers und die Schreibrechte für das Thema in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
