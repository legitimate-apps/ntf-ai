    "They leave Waiting on you on this device. The messages stay in Activity.": {
      "comment": "Clear all menu: what clearing does (nothing is deleted)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They leave Waiting on you on this device. The messages stay in Activity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verschwinden auf diesem Gerät aus „Wartet auf dich“. Die Nachrichten bleiben unter Aktivität."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salen de «Esperando tu respuesta» en este dispositivo. Los mensajes siguen en Actividad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escono da «In attesa di una tua risposta» su questo dispositivo. I messaggi restano in Attività."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znikają z sekcji „Czeka na twoją odpowiedź” na tym urządzeniu. Wiadomości zostają w Aktywności."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze verdwijnen op dit apparaat uit Wacht op jou. De berichten blijven in Activiteit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles quittent « En attente de votre réponse » sur cet appareil. Les messages restent dans Activité."
          }
        }
      }
    },
