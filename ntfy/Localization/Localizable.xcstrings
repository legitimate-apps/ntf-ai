    "This is a test notification from NTF-AI. It has a priority of %lld. If you send another one, it may look different.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a test notification from NTF-AI. It has a priority of %lld. If you send another one, it may look different."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Testnachricht von NTF-AI mit Priorität %lld. Eine weitere Testnachricht kann anders aussehen."
          }
