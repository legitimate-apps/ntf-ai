    "Agent reminders: an unanswered question can alert you again, or remind you silently.": {
      "comment": "What's New 1.27.0",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent reminders: an unanswered question can alert you again, or remind you silently."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen von Agenten: Eine unbeantwortete Frage kann dich erneut benachrichtigen oder lautlos erinnern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios de agentes: una pregunta sin responder puede volver a avisarte o recordártelo sin sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels des agents : une question sans réponse peut vous alerter à nouveau, ou vous le rappeler sans son."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria degli agenti: una domanda senza risposta può avvisarti di nuovo o ricordartelo senza suono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen van agents: een onbeantwoorde vraag kan je opnieuw waarschuwen, of je zonder geluid herinneren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia agentów: pytanie bez odpowiedzi może ponownie cię powiadomić lub przypomnieć bez dźwięku."
          }
        }
      }
    },
    "Agents can ask for a choice, a number, a date, some text or a short form, and you answer right in the app.": {
      "comment": "What's New 1.27.0",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents can ask for a choice, a number, a date, some text or a short form, and you answer right in the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten können nach einer Auswahl, einer Zahl, einem Datum, einem Text oder einem kurzen Formular fragen, und du antwortest direkt in der App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes pueden pedirte una opción, un número, una fecha, un texto o un formulario breve, y respondes directamente en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents peuvent demander un choix, un nombre, une date, un texte ou un court formulaire, et vous répondez directement dans l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli agenti possono chiederti una scelta, un numero, una data, un testo o un breve modulo, e rispondi direttamente nell'app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents kunnen vragen om een keuze, een getal, een datum, een tekst of een kort formulier, en je antwoordt direct in de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenci mogą prosić o wybór, liczbę, datę, tekst lub krótki formularz, a ty odpowiadasz bezpośrednio w aplikacji."
          }
        }
      }
    },
    "All topics for %@ use this login. Leave the secret blank to keep it unchanged. Enter a new secret when changing the sign-in method.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All topics for %@ use this login. Leave the secret blank to keep it unchanged. Enter a new secret when changing the sign-in method."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Themen auf %@ nutzen diese Anmeldung. Lass das Geheimnis leer, um es beizubehalten. Gib beim Wechsel der Anmeldeart ein neues ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los tópicos de %@ usan este acceso. Deja el secreto vacío para conservarlo. Introduce uno nuevo al cambiar el método de acceso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli argomenti su %@ usano queste credenziali. Lascia vuoto il segreto per mantenerlo. Inserisci un nuovo segreto se cambi il metodo di accesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie tematy na %@ używają tych danych logowania. Pozostaw pole hasła lub tokenu puste, aby zachować obecną wartość. Przy zmianie metody logowania podaj nową wartość."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle onderwerpen op %@ gebruiken deze inloggegevens. Laat het geheim leeg om het te behouden. Voer een nieuw geheim in als je de inlogmethode wijzigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les sujets de %@ utilisent ces identifiants. Laissez le secret vide pour le conserver. Saisissez un nouveau secret si vous changez de méthode de connexion."
          }
        }
      }
    },
    "Allow notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen erlauben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir notificaciones"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti notifiche"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na powiadomienia"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen toestaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les notifications"
          }
        }
      }
    },
    "Allow notifications so each message sent to %@ shows up on your lock screen, even when the app is closed. You'll be asked for permission next.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications so each message sent to %@ shows up on your lock screen, even when the app is closed. You'll be asked for permission next."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Benachrichtigungen, damit Nachrichten an %@ auch bei geschlossener App auf dem Sperrbildschirm erscheinen. Als Nächstes wirst du um Erlaubnis gebeten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones para que cada mensaje enviado a %@ aparezca en la pantalla bloqueada, incluso con la app cerrada. A continuación se te pedirá permiso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le notifiche per vedere ogni messaggio inviato a %@ sulla schermata di blocco, anche quando l'app è chiusa. Al passaggio successivo ti verrà chiesto il permesso."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na powiadomienia, aby każda wiadomość wysłana do %@ pojawiała się na ekranie blokady, nawet gdy aplikacja jest zamknięta. W następnym kroku pojawi się prośba o zgodę."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta meldingen toe zodat elk bericht aan %@ op je toegangsscherm verschijnt, ook als de app gesloten is. Hierna wordt om toestemming gevraagd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications pour voir chaque message envoyé à %@ sur l’écran verrouillé, même quand l’app est fermée. Une demande d’autorisation s’affichera ensuite."
          }
        }
      }
    },
    "Allow notifications to receive alerts.": {
      "extractionState": "manual",
      "localizations": {
