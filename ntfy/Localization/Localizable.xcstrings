            "state": "translated",
            "value": "Kies een eigen naam voor dit onderwerp. Laat dit leeg om de onderwerpnaam te gebruiken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un nom personnalisé pour ce sujet. Laissez vide pour utiliser le nom du sujet."
          }
        }
      }
    },
    "Check whether %@ receives forwarded wake-ups for this topic. This cannot prove delivery to your device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check whether %@ receives forwarded wake-ups for this topic. This cannot prove delivery to your device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob %@ weitergeleitete Wecksignale für dieses Thema erhält. Das bestätigt keine Zustellung an dein Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si %@ recibe avisos reenviados de este tópico. Esto no demuestra la entrega al dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se %@ riceve i segnali di risveglio inoltrati per questo argomento. Non prova la consegna al dispositivo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy %@ odbiera przekazane sygnały wybudzenia dla tego tematu. Nie potwierdza to dostarczenia na urządzenie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of %@ doorgestuurde activeringssignalen voor dit onderwerp ontvangt. Dit bewijst geen bezorging op je apparaat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez si %@ reçoit les demandes de réveil relayées pour ce sujet. Cela ne prouve pas leur réception sur votre appareil."
          }
        }
      }
    },
    "%@ received a wake-up for this topic at %@, and FCM accepted it. This does not prove your device received it or that this test caused the wake-up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ received a wake-up for this topic at %@, and FCM accepted it. This does not prove your device received it or that this test caused the wake-up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat um %@ ein Wecksignal für dieses Thema erhalten und FCM hat es angenommen. Das bestätigt weder den Empfang auf deinem Gerät noch, dass dieser Test das Wecksignal ausgelöst hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recibió un aviso para este tópico a las %@ y FCM lo aceptó. Esto no demuestra que tu dispositivo lo recibiera ni que esta prueba lo causara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha ricevuto un segnale di risveglio per questo argomento alle %@ e FCM lo ha accettato. Questo non prova che il dispositivo l'abbia ricevuto o che il segnale sia stato causato da questa prova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odebrał sygnał wybudzenia dla tego tematu o %@, a FCM go przyjął. Nie dowodzi to odebrania przez urządzenie ani tego, że sygnał wywołał ten test."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft om %@ een activeringssignaal voor dit onderwerp ontvangen en FCM heeft het geaccepteerd. Dit bewijst niet dat je apparaat het ontving of dat deze test het signaal veroorzaakte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a reçu une demande de réveil pour ce sujet à %@, et FCM l’a acceptée. Cela ne prouve ni sa réception sur votre appareil ni que ce test l’a déclenchée."
          }
        }
      }
    },
