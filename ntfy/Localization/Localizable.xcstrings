    "Set a custom name for this topic. Leave empty to use the topic name.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a custom name for this topic. Leave empty to use the topic name."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege einen eigenen Namen für dieses Thema fest. Lass das Feld leer, um den Themennamen zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define un nombre para este tópico. Déjalo vacío para usar el nombre del tópico."
          }
        },
        "it": {
