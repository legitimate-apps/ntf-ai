    "An agent can remind you of a question you haven't answered: up to three times, at least five minutes apart. Off, reminders arrive silently.": {
      "comment": "Settings footer under Agent reminders",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent can remind you of a question you haven't answered: up to three times, at least five minutes apart. Off, reminders arrive silently."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Agent kann dich an eine unbeantwortete Frage erinnern: bis zu dreimal, mit mindestens fünf Minuten Abstand. Wenn aus, kommen Erinnerungen ohne Ton."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente puede recordarte una pregunta sin responder: hasta tres veces, con al menos cinco minutos de separación. Si está desactivado, los recordatorios llegan sin sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent peut vous rappeler une question restée sans réponse : jusqu’à trois fois, à au moins cinq minutes d’intervalle. Désactivés, les rappels arrivent sans son."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente può ricordarti una domanda a cui non hai risposto: fino a tre volte, ad almeno cinque minuti di distanza. Se disattivati, i promemoria arrivano senza suono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een agent kan je herinneren aan een vraag die je nog niet hebt beantwoord: tot drie keer, minstens vijf minuten na elkaar. Staat dit uit, dan komen herinneringen zonder geluid binnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent może przypomnieć ci o pytaniu bez odpowiedzi: do trzech razy, co najmniej pięć minut odstępu. Gdy ta opcja jest wyłączona, przypomnienia przychodzą bez dźwięku."
          }
        }
      }
    },
    "An automatic relay check requires HTTPS for both your topic server and the relay. No test message was sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An automatic relay check requires HTTPS for both your topic server and the relay. No test message was sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine automatische Weiterleitungsprüfung müssen dein Themenserver und der Relay-Server HTTPS nutzen. Es wurde keine Testnachricht gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación automática requiere HTTPS tanto en el servidor del tópico como en el relay. No se envió ningún mensaje de prueba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo automatico del relay richiede HTTPS sia sul server dell'argomento sia sul relay. Nessun messaggio di prova è stato inviato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczny test serwera pośredniczącego wymaga HTTPS na serwerze tematu i serwerze pośredniczącym. Nie wysłano wiadomości testowej."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een automatische relaycontrole vereist HTTPS voor zowel je onderwerpserver als de relay. Er is geen testbericht gestuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification automatique du relais nécessite HTTPS pour le serveur du sujet et le relais. Aucun message de test n’a été envoyé."
          }
        }
      }
    },
