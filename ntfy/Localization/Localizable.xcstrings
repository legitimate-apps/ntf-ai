    "The server sign-in is unavailable. Unlock your device or sign in again in Settings. Nothing was sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sign-in is unavailable. Unlock your device or sign in again in Settings. Nothing was sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serveranmeldung ist nicht verfügbar. Entsperre dein Gerät oder melde dich in den Einstellungen erneut an. Es wurde nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión del servidor no está disponible. Desbloquea el dispositivo o vuelve a iniciar sesión en Ajustes. No se envió nada."
