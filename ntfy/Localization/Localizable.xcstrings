    "This address or topic name can't be watched on ntfy.sh, so new messages show when you open the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address or topic name can't be watched on ntfy.sh, so new messages show when you open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse oder dieser Themenname kann auf ntfy.sh nicht beobachtet werden, daher erscheinen neue Nachrichten, wenn du die App öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección o nombre de tópico no se puede vigilar en ntfy.sh, así que los mensajes nuevos aparecen al abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse ou ce nom de sujet ne peut pas être surveillé sur ntfy.sh : les nouveaux messages s’affichent à l’ouverture de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo o nome di argomento non può essere osservato su ntfy.sh, quindi i nuovi messaggi compaiono quando apri l’app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
