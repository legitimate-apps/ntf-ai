    "This server already has a login. Go back and edit its existing login.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server already has a login. Go back and edit its existing login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Server sind bereits Zugangsdaten gespeichert. Gehe zurück und bearbeite die vorhandenen Zugangsdaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor ya tiene unas credenciales guardadas. Vuelve atrás y edita las credenciales existentes de este servidor."
          }
        },
        "it": {
          "stringUnit": {
