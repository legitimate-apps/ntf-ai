        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Centro de notificaciones está desactivado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Centro Notifiche è disattivato"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrum powiadomień jest wyłączone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het meldingencentrum staat uit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le centre de notifications est désactivé"
          }
        }
      }
    },
    "Messages you miss won't stay in Notification Center. Tap Open Settings, then turn on Notification Center.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages you miss won't stay in Notification Center. Tap Open Settings, then turn on Notification Center."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verpasste Nachrichten bleiben nicht in der Mitteilungszentrale. Tippe auf „Einstellungen öffnen“ und aktiviere „Mitteilungen“ unter „Hinweise“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes que te pierdas no quedarán en el Centro de notificaciones. Pulsa «Abrir Ajustes» y activa «Centro de notificaciones»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi che ti perdi non restano nel Centro Notifiche. Tocca 'Apri Impostazioni' e attiva 'Centro Notifiche'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości, które przegapisz, nie zostaną w Centrum powiadomień. Stuknij „Otwórz Ustawienia” i włącz „Centrum powiadomień”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten die je mist, blijven niet in het meldingencentrum staan. Tik op 'Instellingen openen' en zet 'Meldingencentrum' aan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages manqués ne resteront pas dans le centre de notifications. Touchez « Ouvrir Réglages », puis activez « Centre de notifications »."
          }
        }
      }
    },
    "Sounds are off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds are off"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Töne sind deaktiviert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos están desactivados"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoni sono disattivati"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięki są wyłączone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geluiden staan uit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons sont désactivés"
          }
        }
      }
    },
    "New messages arrive without a sound. Tap Open Settings, then turn on Sounds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New messages arrive without a sound. Tap Open Settings, then turn on Sounds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Nachrichten kommen ohne Ton an. Tippe auf „Einstellungen öffnen“ und aktiviere „Töne“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes nuevos llegan sin sonido. Pulsa «Abrir Ajustes» y activa «Sonidos»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi messaggi arrivano senza suono. Tocca 'Apri Impostazioni' e attiva 'Suoni'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe wiadomości przychodzą bez dźwięku. Stuknij „Otwórz Ustawienia” i włącz „Dźwięki”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe berichten komen zonder geluid binnen. Tik op 'Instellingen openen' en zet 'Geluiden' aan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux messages arrivent sans son. Touchez « Ouvrir Réglages », puis activez « Sons »."
          }
        }
      }
    },
    "Scheduled Summary is on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled Summary is on"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante Übersicht ist aktiv"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resumen programado está activado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riepilogo programmato è attivo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Planowe podsumowania są włączone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepland overzicht staat aan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résumé programmé est activé"
          }
        }
      }
    },
    "Regular alerts are held and shown together at set times, not right away. Tap Open Settings, then choose Immediate Delivery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular alerts are held and shown together at set times, not right away. Tap Open Settings, then choose Immediate Delivery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale Hinweise werden gesammelt und zu festen Zeiten gemeinsam angezeigt, nicht sofort. Tippe auf „Einstellungen öffnen“ und wähle „Sofortige Zustellung“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos normales se retienen y se muestran juntos a ciertas horas, no al instante. Pulsa «Abrir Ajustes» y elige «Entrega inmediata»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi normali vengono trattenuti e mostrati insieme a orari prestabiliti, non subito. Tocca 'Apri Impostazioni' e scegli 'Recapito immediato'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykłe alerty są wstrzymywane i pokazywane razem o ustalonych porach, a nie od razu. Stuknij „Otwórz Ustawienia” i wybierz „Natychmiast”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewone meldingen worden bewaard en op vaste tijden samen getoond, niet meteen. Tik op 'Instellingen openen' en kies 'Onmiddellijke aflevering'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes ordinaires sont mises de côté et affichées ensemble à des heures fixes, pas tout de suite. Touchez « Ouvrir Réglages », puis choisissez « Distribution immédiate »."
          }
        }
      }
    },
    "Background App Refresh is off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background App Refresh is off"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundaktualisierung ist aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización en segundo plano está desactivada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna app in background è disattivato"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeżanie aplikacji w tle jest wyłączone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ververs op achtergrond staat uit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’actualisation en arrière-plan est désactivée"
          }
        }
      }
    },
    "Messages can arrive late or only when you open the app. Turn it on in the Settings app under General → Background App Refresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages can arrive late or only when you open the app. Turn it on in the Settings app under General → Background App Refresh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten können verspätet oder erst beim Öffnen der App eintreffen. Aktiviere die Hintergrundaktualisierung in der App „Einstellungen“ unter Allgemein → Hintergrundaktualisierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes pueden llegar tarde o solo al abrir la app. Actívala en la app Ajustes, en General → Actualización en segundo plano."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi possono arrivare in ritardo o solo quando apri l’app. Attivalo nell’app Impostazioni, sotto Generali → Aggiorna app in background."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości mogą docierać z opóźnieniem lub dopiero po otwarciu aplikacji. Włącz odświeżanie w aplikacji Ustawienia, w sekcji Ogólne → Odświeżanie aplikacji w tle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten kunnen te laat of pas bij het openen van de app binnenkomen. Zet dit aan in de app Instellingen onder Algemeen → Ververs op achtergrond."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages peuvent arriver en retard ou seulement à l’ouverture de l’app. Activez cette option dans l’app Réglages, sous Général → Actualiser en arrière-plan."
          }
        }
      }
    },
    "Background App Refresh is restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background App Refresh is restricted"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundaktualisierung ist eingeschränkt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización en segundo plano está restringida"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna app in background è limitato"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeżanie aplikacji w tle jest ograniczone"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ververs op achtergrond is beperkt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’actualisation en arrière-plan est restreinte"
          }
        }
      }
    },
    "Screen Time or device management blocks background updates, so messages can arrive late. Only whoever set the restriction can change it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time or device management blocks background updates, so messages can arrive late. Only whoever set the restriction can change it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmzeit oder die Geräteverwaltung blockiert Hintergrundaktualisierungen, daher können Nachrichten verspätet eintreffen. Nur wer die Einschränkung eingerichtet hat, kann sie ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo en pantalla o la administración del dispositivo bloquean las actualizaciones en segundo plano, así que los mensajes pueden llegar tarde. Solo quien definió la restricción puede cambiarla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo di utilizzo o la gestione del dispositivo bloccano gli aggiornamenti in background, quindi i messaggi possono arrivare in ritardo. Solo chi ha impostato la restrizione può modificarla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas przed ekranem lub zarządzanie urządzeniem blokuje odświeżanie w tle, więc wiadomości mogą docierać z opóźnieniem. Ograniczenie może zmienić tylko osoba, która je ustawiła."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermtijd of apparaatbeheer blokkeert achtergrondupdates, dus berichten kunnen te laat binnenkomen. Alleen wie de beperking heeft ingesteld, kan dit wijzigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d’écran ou la gestion de l’appareil bloquent les actualisations en arrière-plan : les messages peuvent arriver en retard. Seule la personne qui a défini la restriction peut la modifier."
          }
        }
      }
    },
    "Low Power Mode is on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power Mode is on"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stromsparmodus ist aktiv"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de bajo consumo está activado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risparmio energetico è attivo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb niskiego zużycia energii jest włączony"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energiebesparingsmodus staat aan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode économie d’énergie est activé"
          }
        }
      }
    },
    "Background updates are paused to save battery, so messages can arrive late. Turn it off in the Settings app under Battery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background updates are paused to save battery, so messages can arrive late. Turn it off in the Settings app under Battery."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrundaktualisierungen werden unterbrochen, um Akku zu sparen, daher können Nachrichten verspätet eintreffen. Deaktiviere den Stromsparmodus in der App „Einstellungen“ unter Batterie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones en segundo plano se pausan para ahorrar batería, así que los mensajes pueden llegar tarde. Desactívalo en la app Ajustes, en Batería."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti in background vengono sospesi per risparmiare batteria, quindi i messaggi possono arrivare in ritardo. Disattivalo nell’app Impostazioni, sotto Batteria."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odświeżanie w tle jest wstrzymywane, aby oszczędzać baterię, więc wiadomości mogą docierać z opóźnieniem. Wyłącz tryb niskiego zużycia energii w aplikacji Ustawienia, w sekcji Bateria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtergrondupdates worden onderbroken om batterij te sparen, dus berichten kunnen te laat binnenkomen. Zet de energiebesparingsmodus uit in de app Instellingen onder Batterij."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actualisations en arrière-plan sont suspendues pour économiser la batterie : les messages peuvent arriver en retard. Désactivez ce mode dans l’app Réglages, sous Batterie."
          }
        }
      }
    },
    "The next poll fetches messages missed by dropped pushes, while they remain in the server cache.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next poll fetches messages missed by dropped pushes, while they remain in the server cache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim nächsten Abruf werden durch ausgebliebene Pushs verpasste Nachrichten aus dem Servercache geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes perdidos por notificaciones push que no llegaron se recuperan en la próxima consulta, si siguen en la caché del servidor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi persi per notifiche push non arrivate vengono recuperati alla prossima verifica, se sono ancora nella cache del server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości pominięte z powodu niedostarczonych powiadomień push zostaną pobrane przy następnym odpytywaniu, jeśli są jeszcze w pamięci podręcznej serwera."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichten die door gemiste pushmeldingen ontbraken, worden bij de volgende controle opgehaald zolang ze nog in de servercache staan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages manqués à cause de notifications push non reçues sont récupérés à la prochaine interrogation, s’ils sont encore dans le cache du serveur."
          }
        }
      }
    },
    "Use Read messages in Shortcuts to read stored messages from a topic.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Read messages in Shortcuts to read stored messages from a topic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies gespeicherte Nachrichten eines Themas mit „Nachrichten lesen“ in der App „Kurzbefehle“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Leer mensajes en Atajos para leer los mensajes guardados de un tópico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Leggi messaggi in Comandi Rapidi per leggere i messaggi salvati di un argomento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj akcji Odczytaj wiadomości w Skrótach, aby czytać zapisane wiadomości z tematu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Berichten lezen in Opdrachten om opgeslagen berichten van een onderwerp te lezen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Lire les messages dans Raccourcis pour lire les messages enregistrés d’un sujet."
          }
        }
      }
    },
    "Choose Topics saved in account when adding a subscription on a server you are signed in to.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Topics saved in account when adding a subscription on a server you are signed in to."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonniere „Im Konto gespeicherte Themen“, wenn du beim Server angemeldet bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al añadir una suscripción en un servidor donde has iniciado sesión, elige Tópicos guardados en la cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aggiungi un’iscrizione su un server a cui hai effettuato l’accesso, scegli Argomenti salvati nell’account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodając subskrypcję na serwerze, na którym jesteś zalogowany, wybierz Tematy zapisane na koncie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies Onderwerpen opgeslagen in account wanneer je een abonnement toevoegt op een server waarop je bent ingelogd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Sujets enregistrés dans le compte lors de l’ajout d’un abonnement sur un serveur auquel vous êtes connecté."
          }
        }
      }
    },
    "Notification status now shows iOS settings that hide or delay alerts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification status now shows iOS settings that hide or delay alerts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Benachrichtigungsstatus zeigt jetzt iOS-Einstellungen, die Hinweise ausblenden oder verzögern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de notificaciones ahora muestra los ajustes de iOS que ocultan o retrasan los avisos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato notifiche ora mostra le impostazioni di iOS che nascondono o ritardano gli avvisi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan powiadomień pokazuje teraz ustawienia iOS, które ukrywają lub opóźniają alerty."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
