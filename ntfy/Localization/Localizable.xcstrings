    "NTF-AI brings your AI agents and scripts into one inbox: their notifications arrive, and you answer with a tap or a reply.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NTF-AI brings your AI agents and scripts into one inbox: their notifications arrive, and you answer with a tap or a reply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NTF-AI holt deine KI-Agenten und Skripte in einen Posteingang: Ihre Benachrichtigungen kommen an, und du antwortest mit einem Tippen oder einer Nachricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NTF-AI reúne tus agentes de IA y scripts en una sola bandeja: recibes sus notificaciones y respondes con un toque o un mensaje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NTF-AI riunisce i tuoi agenti IA e script in un'unica casella: le loro notifiche arrivano e rispondi con un tocco o un messaggio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NTF-AI zbiera Twoich agentów AI i skrypty w jednej skrzynce: ich powiadomienia docierają, a Ty odpowiadasz dotknięciem lub wiadomością."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NTF-AI brengt je AI-agents en scripts samen in één inbox: hun meldingen komen binnen en je antwoordt met een tik of een bericht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NTF-AI réunit vos agents IA et scripts dans une seule boîte de réception : leurs notifications arrivent, et vous répondez d'un toucher ou d'un message."
          }
        }
      }
    },
    "Messages on this topic are end-to-end encrypted. The password isn't in this link; I'll send it separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages on this topic are end-to-end encrypted. The password isn't in this link; I'll send it separately."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten in diesem Thema sind Ende-zu-Ende-verschlüsselt. Das Passwort steht nicht in diesem Link; ich schicke es dir separat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes de este tópico están cifrados de extremo a extremo. La contraseña no está en este enlace; te la enviaré por separado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
