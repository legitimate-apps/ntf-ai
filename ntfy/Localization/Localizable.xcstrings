            "value": "Les bannières sont désactivées"
          }
        }
      }
    },
    "New messages won't pop up on screen. Tap Open Settings, then turn on Banners.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New messages won't pop up on screen. Tap Open Settings, then turn on Banners."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Nachrichten erscheinen nicht als Banner auf dem Bildschirm. Tippe auf „Einstellungen öffnen“ und aktiviere „Banner“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes nuevos no aparecerán en pantalla. Pulsa «Abrir Ajustes» y activa «Tiras»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi messaggi non compaiono sullo schermo. Tocca 'Apri Impostazioni' e attiva 'Banner'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe wiadomości nie pojawią się na ekranie. Stuknij „Otwórz Ustawienia” i włącz „Banery”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe berichten verschijnen niet bovenaan het scherm. Tik op 'Instellingen openen' en zet 'Stroken' aan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux messages ne s’afficheront pas à l’écran. Touchez « Ouvrir Réglages », puis activez « Bannières »."
          }
        }
      }
