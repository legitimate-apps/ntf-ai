    "The encrypted message would be %lld bytes; the limit is %lld. Shorten it. Nothing was sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted message would be %lld bytes; the limit is %lld. Shorten it. Nothing was sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verschlüsselte Nachricht wäre %lld Byte groß, das Limit ist %lld. Kürze sie. Es wurde nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje cifrado ocuparía %lld bytes; el límite es %lld. Acórtalo. No se envió nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio cifrato sarebbe di %lld byte; il limite è %lld. Accorcialo. Non è stato inviato nulla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaszyfrowana wiadomość miałaby %lld bajtów; limit wynosi %lld. Skróć ją. Niczego nie wysłano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het versleutelde bericht zou %lld bytes groot zijn; de limiet is %lld. Maak het korter. Er is niets verstuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message chiffré ferait %lld octets ; la limite est de %lld. Raccourcissez-le. Rien n’a été envoyé."
          }
        }
      }
    },
    "The encryption key is unavailable. Nothing was sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encryption key is unavailable. Nothing was sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel ist nicht verfügbar. Es wurde nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de cifrado no está disponible. No se envió nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave crittografica non è disponibile. Non è stato inviato nulla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz szyfrowania jest niedostępny. Niczego nie wysłano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelingssleutel is niet beschikbaar. Er is niets verstuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de chiffrement est indisponible. Rien n’a été envoyé."
          }
        }
      }
    },
    "The encryption password is unavailable. Unlock your device or set the topic password again. Nothing was sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encryption password is unavailable. Unlock your device or set the topic password again. Nothing was sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verschlüsselungspasswort ist nicht verfügbar. Entsperre dein Gerät oder lege das Themenpasswort erneut fest. Es wurde nichts gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña de cifrado no está disponible. Desbloquea el dispositivo o configura de nuevo la contraseña del tópico. No se envió nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password di cifratura non è disponibile. Sblocca il dispositivo o imposta di nuovo la password dell'argomento. Non è stato inviato nulla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło szyfrowania jest niedostępne. Odblokuj urządzenie lub ponownie ustaw hasło tematu. Nic nie wysłano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het versleutelingswachtwoord is niet beschikbaar. Ontgrendel je apparaat of stel het onderwerpwachtwoord opnieuw in. Er is niets verstuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe de chiffrement est indisponible. Déverrouillez votre appareil ou définissez à nouveau le mot de passe du sujet. Rien n’a été envoyé."
          }
        }
      }
    },
    "The file could not be opened. Choose it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file could not be opened. Choose it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht geöffnet werden. Wähle sie erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el archivo. Elígelo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il file. Sceglilo di nuovo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można otworzyć pliku. Wybierz go ponownie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand kon niet worden geopend. Kies het opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’a pas pu être ouvert. Sélectionnez-le à nouveau."
          }
        }
      }
    },
    "The headers could not be saved to the Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The headers could not be saved to the Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Header konnten nicht im Schlüsselbund gespeichert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar las cabeceras en el Llavero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le intestazioni nel portachiavi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać nagłówków w pęku kluczy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De headers konden niet in de sleutelhanger worden bewaard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les en-têtes dans le trousseau."
          }
        }
      }
    },
    "The message could not be encrypted, so it was not sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message could not be encrypted, so it was not sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht konnte nicht verschlüsselt werden und wurde daher nicht gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cifrar el mensaje, por lo que no se envió."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio non è stato inviato perché non è stato possibile cifrarlo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaszyfrować wiadomości, więc jej nie wysłano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bericht kon niet worden versleuteld en is daarom niet verstuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n’a pas pu être chiffré et n’a donc pas été envoyé."
          }
        }
      }
    },
    "The relay could not be reached. This check cannot tell whether wake-ups are forwarding. Try again when the connection is available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay could not be reached. This check cannot tell whether wake-ups are forwarding. Try again when the connection is available."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Relay-Server ist nicht erreichbar. Diese Prüfung kann daher keine Aussage zur Weiterleitung treffen. Versuche es bei verfügbarer Verbindung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar al relay. Esta comprobación no permite saber si se reenvían los avisos. Inténtalo cuando se restablezca la conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere il relay. Il controllo non può stabilire se i segnali di risveglio vengono inoltrati. Riprova quando la connessione sarà disponibile."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z serwerem pośredniczącym. Test nie określi, czy sygnały wybudzenia są przekazywane. Spróbuj ponownie po odzyskaniu połączenia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De relay is niet bereikbaar. Deze controle kan niet vaststellen of activeringssignalen worden doorgestuurd. Probeer het opnieuw zodra er verbinding is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais est injoignable. Cette vérification ne peut pas déterminer si les demandes de réveil sont relayées. Réessayez quand la connexion sera disponible."
          }
        }
      }
    },
    "The relay did not return a valid check result (HTTP %lld). This does not establish whether forwarding works.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay did not return a valid check result (HTTP %lld). This does not establish whether forwarding works."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Relay-Server lieferte kein gültiges Prüfergebnis (HTTP %lld). Ob die Weiterleitung funktioniert, ist damit nicht geklärt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relay no devolvió un resultado válido (HTTP %lld). Esto no demuestra si funciona el reenvío."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay non ha restituito un risultato valido (HTTP %lld). Questo non stabilisce se l'inoltro funziona."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer pośredniczący nie zwrócił poprawnego wyniku testu (HTTP %lld). Nie określa to, czy przekazywanie działa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De relay gaf geen geldig controleresultaat terug (HTTP %lld). Hiermee is niet vastgesteld of doorsturen werkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais n’a pas renvoyé de résultat de vérification valide (HTTP %lld). Cela ne permet pas de savoir si le relais fonctionne."
          }
        }
      }
    },
    "The relay is pausing requests after a rate limit. Wait for the requested delay or the relevant server or request change before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay is pausing requests after a rate limit. Wait for the requested delay or the relevant server or request change before trying again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Relay-Server pausiert Anfragen nach einem Limit. Warte die geforderte Zeit oder die nötige Änderung am Server oder an der Anfrage ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relay pausa las solicitudes tras un límite de frecuencia. Espera el tiempo indicado o el cambio necesario del servidor o la solicitud antes de reintentar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay sospende le richieste dopo un limite di frequenza. Attendi il tempo indicato o una modifica pertinente del server o della richiesta prima di riprovare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer pośredniczący wstrzymuje żądania po przekroczeniu limitu. Przed ponowną próbą odczekaj wskazany czas lub zaczekaj na odpowiednią zmianę serwera lub żądania."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De relay wacht na een verzoeklimiet. Wacht de aangegeven tijd of een relevante server- of verzoekwijziging af voordat je het opnieuw probeert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais suspend les requêtes après une limitation de débit. Attendez le délai demandé ou la modification du serveur ou de la requête avant de réessayer."
          }
        }
      }
    },
    "The relay rate limited this check. %@ No automatic retry will be sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay rate limited this check. %@ No automatic retry will be sent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Relay-Server hat diese Prüfung begrenzt. %@ Es erfolgt kein automatischer neuer Versuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relay limitó esta comprobación. %@ No se reintentará automáticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay ha limitato questo controllo. %@ Non verrà effettuato alcun tentativo automatico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer pośredniczący ograniczył ten test. %@ Nie będzie automatycznej ponownej próby."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De relay heeft deze controle beperkt. %@ Er volgt geen automatische nieuwe poging."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais a limité le débit de cette vérification. %@ Aucun nouvel essai automatique ne sera envoyé."
          }
        }
      }
    },
    "The relay supports a wake-up check. Sending the test needs your approval.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The relay supports a wake-up check. Sending the test needs your approval."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Relay-Server unterstützt eine Weiterleitungsprüfung. Vor dem Senden des Tests ist deine Zustimmung nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relay admite la comprobación de avisos. Enviar la prueba necesita tu autorización."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il relay supporta un controllo del risveglio. L'invio della prova richiede la tua approvazione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer pośredniczący obsługuje test wybudzenia. Wysłanie testu wymaga Twojej zgody."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De relay ondersteunt een activeringscontrole. Voor het sturen van de test is je toestemming nodig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le relais prend en charge la vérification des demandes de réveil. Votre accord est nécessaire pour envoyer le test."
          }
        }
      }
    },
    "The saved headers could not be deleted from the Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved headers could not be deleted from the Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Header konnten nicht aus dem Schlüsselbund gelöscht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron eliminar las cabeceras guardadas del Llavero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare le intestazioni salvate dal portachiavi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
